<div class="sidebar @SidebarCssClass">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">KakuroSolver.Web</a>
        </div>
    </div>

    <div class="@NavMenuCssClass nav-scrollable">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="counter" @onclick="CloseNavMenu">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="weather" @onclick="CloseNavMenu">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
                </NavLink>
            </div>
        </nav>
    </div>
</div>

@code {
    [Parameter] public bool IsCollapsed { get; set; }

    private string SidebarCssClass => IsCollapsed ? "sidebar-collapsed" : "sidebar-expanded";

    private string NavMenuCssClass => IsCollapsed ? "collapse" : "expanded";

    private void CloseNavMenu() { }
}
